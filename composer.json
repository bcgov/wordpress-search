{
  "name": "bcgov-plugin/wordpress-search",
  "description": "WordPress Search Plugin",
  "type": "wordpress-plugin",
  "license": "Apache-2.0",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/bcgov/wordpress-utils.git"
    }
  ],
  "require-dev": {
    "bcgov/wordpress-utils": "2.7.0",
    "yoast/phpunit-polyfills": "^1.0",
    "composer/composer": "^2.9.3"
  },
  "autoload": {
    "psr-4": {
      "Bcgov\\WordpressSearch\\": "src/",
      "Bcgov\\WordpressSearch\\Test\\": "tests/php/"
    }
  },
  "scripts": {
    "test-setup": [
      "bash vendor/bcgov/wordpress-utils/bin/install-wp-tests.sh wordpress_test root 'rootpassword' 0.0.0.0 latest"
    ],
    "production": [
      "composer validate",
      "composer phpcbf",
      "composer phpcs",
      "npm run fix:js",
      "npm run fix:css"
    ],
    "phpcs": [
      "Bcgov\\Script\\Standards::phpcs"
    ],
    "phpcbf": [
      "Bcgov\\Script\\Standards::phpcbf"
    ],
    "test": [
      "vendor/bin/phpunit --testdox "
    ],
    "coverage": [
      "vendor/bin/phpunit --coverage-html ./coverage/php/"
    ],
    "phpcs-allow-todo": [
      "vendor/bin/phpcs -ps --standard=./vendor/bcgov/wordpress-utils/wordpress.xml  --exclude=Generic.Commenting.Todo --colors --ignore=**/build/** ./"
    ]
  },
  "config": {
    "platform": {
      "php": "7.4"
    },
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
